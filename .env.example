# Local defaults copied to .env.local by the dev and benchmark runners.
NODE_ENV=development
PORT=3001

# Optional endpoint for direct Astro development runs; npm run dev uses its same-origin proxy.
# Production uses the Vercel VITE_WEBSOCKET_URL environment variable.
VITE_WEBSOCKET_URL=

# Gameplay uses the current snapshot protocol and asteroid interactions; no protocol switches.

# Persistent world database. Production must use its mounted Railway volume.
GEOROIDS_WORLD_PATH=.data/world.sqlite
