#!/usr/bin/env bash
# Pre-push gate + deploy for GeoRoids.
#
# Thin shim over the shared fleet gate library (dotagents/gate/gate-lib.sh): the
# ~100 lines of shared boilerplate — push-ref parsing, the gitleaks secrets scan,
# markdown-lint-on-change, the doc-only fast path, the working-tree guards, and
# run_step (silent on green, full output on red) — live in the lib. This file
# declares only GeoRoids' quality steps and the Vercel production deploy. We
# deploy from the hook because the Vercel↔GitHub git integration is disconnected,
# so the push is the deploy trigger and a failed deploy fails the push.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"; cd "$ROOT"
# shellcheck source=/dev/null
source "${DOTAGENTS_GATE_LIB:-$HOME/code/dotagents/gate/gate-lib.sh}" || {
  echo "✗ dotagents gate-lib not found (expected ~/code/dotagents/gate/gate-lib.sh) — re-run install-local-agent-runtime.sh." >&2
  exit 1
}

gate_begin "GeoRoids" deploys   # parse push; gitleaks; md-lint; doc-only fast path; banner; ERR trap
gate_require_clean_tree         # refuse dirty tree / pushed-SHA≠HEAD / non-fast-forward

# --- Quality gate (run_step: silent on green, full output + abort on red) ---
run_step "lint"   npm run lint
run_step "yaml lint" npm run check:yaml
run_step "tsc"    npm run check:ts
run_step "vitest" npm test

# --- Deploy: production deploy to Vercel (remote build; streams) ---
gate_deploy_vercel team_T8yHg0aDz7nCbyBgJh5a2saR prj_2uyFHuUn3HM9Ul7BwHuvoqgqeqKR
echo "✓ pre-push gate + deploy complete"
