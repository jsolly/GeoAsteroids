#!/usr/bin/env bash
# BEGIN dotagents fleet pre-commit guard
ROOT="$(git rev-parse --show-toplevel)"
if [ -x "$ROOT/.agents/scripts/fleet-precommit-check.sh" ]; then
  bash "$ROOT/.agents/scripts/fleet-precommit-check.sh" || exit 1
fi
# END dotagents fleet pre-commit guard

set -e

# Skip if running in CI environment
if [ -n "$CI" ]; then
  echo "Skipping pre-commit hooks in CI environment"
  exit 0
fi

echo "Ensuring staged files are linted/formatted..."
npx lint-staged

echo "Running TypeScript type check..."
npm run check:ts

echo "Running unit tests..."
npm run test

exit 0
