{
  "name": "geoasteroids",
  "private": true,
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "prune": "ts-prune",
    "dev": "vite",
    "dev:multiplayer": "tsx setup/localWebSocketServer.ts",
    "dev:full": "concurrently --kill-others --prefix-colors \"blue.bold,green.bold,yellow.bold\" --prefix \"[{name}]\" --names \"vite,multiplayer,logs,api,logserver\" \"npm run dev\" \"npm run dev:multiplayer\" \"npm run log:watch\" \"npm run log:api\" \"node setup/logServer.js\"",
    "log:watch": "node setup/logWatcher.js",
    "log:api": "tsx api/logs.ts",
    "log:show": "node setup/logWriter.js show",
    "log:clear": "node setup/logWriter.js clear",
    "log:tail": "tail -f logs/debug-logs.txt",
    "build": "tsc && vite build",
    "start": "vite",
    "watch": "vite build --watch",
    "preview": "vite preview",
    "test": "vitest --run",
    "coverage": "vitest run --coverage",
    "check:ts": "tsc --noEmit",
    "check:lint": "eslint .",
    "check:fix": "eslint . --fix",
    "fix": "npm run check:fix && npm run check:ts",
    "lint": "eslint .",
    "format": "prettier --write",
    "prepare": "husky install"
  },
  "lint-staged": {
    "./**/*.{js,cjs,ts,css,html,json,geojson,yml,yaml,md}": "prettier --write",
    "./**/*.{js,cjs,ts}": "eslint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsolly/GeoAsteroids.git"
  },
  "author": "jsolly",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jsolly/GeoAsteroids/issues"
  },
  "homepage": "https://github.com/jsolly/GeoAsteroids#readme",
  "devDependencies": {
    "@types/node": "^24.0.15",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.37.0",
    "@vercel/node": "^5.3.6",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "^3.2.4",
    "canvas": "^3.1.2",
    "concurrently": "^9.1.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-tsdoc": "^0.4.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.2",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.1",
    "ts-prune": "^0.10.3",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vercel": "^44.5.0",
    "vite": "^7.0.5",
    "vitest": "^3.2.4",
    "ws": "^8.18.0"
  },
  "dependencies": {
    "@types/jsdom": "^21.1.1",
    "dotenv": "^17.2.0",
    "mongodb": "^6.17.0",
    "socket.io-client": "^4.8.1",
    "uuid": "^11.0.0"
  }
}
