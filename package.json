{
  "name": "geoasteroids",
  "private": true,
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "prune": "ts-prune",
    "dev": "vite",
    "dev:multiplayer": "tsx --env-file=.env server.ts",
    "dev:full": "concurrently --kill-others --prefix-colors \"blue.bold,green.bold\" --prefix \"[{name}]\" --names \"vite,multiplayer\" \"npm run dev\" \"npm run dev:multiplayer\"",
    "build": "tsc && vite build",
    "start": "vite",
    "watch": "vite build --watch",
    "preview": "vite preview",
    "test": "vitest --run",
    "check:ts": "tsc --noEmit",
    "check:lint": "biome check .",
    "check:fix": "biome check --write .",
    "fix": "biome check --write . && npm run check:ts && npm run test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepare": "if [ -d .git ]; then husky install; fi"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md,yml,yaml}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsolly/GeoAsteroids.git"
  },
  "author": "jsolly",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jsolly/GeoAsteroids/issues"
  },
  "homepage": "https://github.com/jsolly/GeoAsteroids#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "mongodb": "^6.17.0",
    "socket.io-client": "^4.8.1",
    "uuid": "^11.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@biomejs/biome": "https://pkg.pr.new/@biomejs/biome@7248dda",
    "@types/jsdom": "^21.1.1",
    "@types/node": "^24.0.15",

    "@types/ws": "^8.18.1",
    "@vercel/node": "^5.3.6",
    "canvas": "^3.1.2",
    "concurrently": "^9.1.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.2",
    "ts-node": "^10.9.1",
    "ts-prune": "^0.10.3",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vercel": "^48.1.5",
    "vite": "^7.0.5",
    "vitest": "^3.2.4"
  }
}
