# Local defaults copied to .env.local by the dev and benchmark runners.
NODE_ENV=development
PORT=3001

# Optional endpoint for direct Astro development runs; npm run dev uses its same-origin proxy.
# Production uses the Vercel VITE_WEBSOCKET_URL environment variable.
VITE_WEBSOCKET_URL=

# Gameplay uses the current snapshot protocol and asteroid interactions; no protocol switches.

# Persistent world database. Production must use its mounted Railway volume.
GEOROIDS_WORLD_PATH=.data/world.sqlite

# Debug reports use a separate durable store. Production defaults beside the world DB.
# Set these only on the game server; never use a VITE_ or PUBLIC_ prefix for credentials.
GEOROIDS_DEBUG_REPORTS_PATH=.data/debug-reports.sqlite
GEOROIDS_DEBUG_REPORTS_SECTION_ID=6hmMfqqQ4rwgJFGv
# TODOIST_API_TOKEN is a server secret supplied by the owner. Do not commit its value.
# GEOROIDS_DEBUG_REPORTS_ENABLED=0 disables report storage and delivery.
