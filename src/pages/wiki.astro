---
import { getCollection } from 'astro:content';
import WikiShell from '../components/wiki/WikiShell.svelte';
import '../styles/theme.css';

const articles = (await getCollection('wiki'))
  .map((entry) => entry.data)
  .sort((a, b) => a.order - b.order || a.title.localeCompare(b.title));
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>GeoRoids Field Manual | Ships, Controls and Teamwork</title>
    <meta
      name="description"
      content="The GeoRoids field manual. Meet every ship, learn its abilities, and explore combat, asteroids, pickups, and flight with animated demonstrations."
    />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="canonical" href="https://www.georoids.com/wiki/" />
    <link rel="icon" href="/favicon.ico" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="GeoRoids Field Manual | Ships, Controls and Teamwork" />
    <meta
      property="og:description"
      content="Meet every ship, learn its abilities, and explore combat, asteroids, pickups, and flight with animated demonstrations."
    />
    <meta property="og:url" content="https://www.georoids.com/wiki/" />
    <meta
      property="og:image"
      content="https://www.georoids.com/wiki/uploads/georoids-first-flight.png"
    />
    <meta property="og:image:width" content="640" />
    <meta property="og:image:height" content="360" />
    <meta
      property="og:image:alt"
      content="A Scout flying through space in the GeoRoids movement demonstration."
    />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <WikiShell {articles} client:load />
  </body>
</html>
